{
  "version": 1,
  "about": "Hand-written golden cases for the pricing and GST engine. Every platform (Go server, Dart device, Python oracle) must reproduce each 'expected' exactly. Amounts are paise. Rules: docs/learn/01-money-and-gst-engine.md. Before pilot, a chartered accountant signs off these cases and the 500-bill set that grows from them.",
  "cases": [
    {
      "name": "single-item-exclusive-5pct",
      "why": "Dal makhani Rs 100, prices exclusive of GST: 2.50 CGST + 2.50 SGST on top.",
      "input": {
        "price_mode": "exclusive",
        "supply": "intra",
        "rounding": "nearest_rupee",
        "lines": [
          {
            "ref": "dal",
            "name": "Dal makhani",
            "qty": 1,
            "unit_price_paise": 10000,
            "tax_rate_bp": 500
          }
        ]
      },
      "expected": {
        "result": {
          "lines": [
            {
              "ref": "dal",
              "gross": 10000,
              "line_discount": 0,
              "bill_discount": 0,
              "net": 10000
            }
          ],
          "subtotal": 10000,
          "discount_total": 0,
          "service_charge": 0,
          "taxable_total": 10000,
          "tax_groups": [
            {
              "rate_bp": 500,
              "net": 10000,
              "goods_value": 10000,
              "service_charge": 0,
              "taxable": 10000,
              "cgst": 250,
              "sgst": 250,
              "igst": 0
            }
          ],
          "cgst": 250,
          "sgst": 250,
          "igst": 0,
          "tax_total": 500,
          "round_off": 0,
          "grand_total": 10500
        }
      }
    },
