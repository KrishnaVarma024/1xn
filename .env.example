# Copy to .env for your own tools. Never commit a real .env (it is gitignored).
# These are the local Docker defaults; production values live in AWS Secrets Manager.

# Owner role: runs migrations only.
MIGRATE_DATABASE_URL=postgres://onexn_owner:dev@localhost:5432/onexn?sslmode=disable
# App role: what the API connects as. Row-Level Security applies.
DATABASE_URL=postgres://onexn_app:dev@localhost:5432/onexn?sslmode=disable
# Owner connection to the maintenance DB; the e2e tests create throwaway databases here.
TEST_DATABASE_URL=postgres://onexn_owner:dev@localhost:5432/postgres?sslmode=disable
HTTP_ADDR=:8080
API_URL=http://localhost:8080
