# Your own settings. Copy to .env (gitignored, never commit it) and keep only
# what you change. Every make command reads .env, in every terminal.
# Production values live in AWS Secrets Manager, never here.

# The Docker Postgres (make up) is on 5433, so it never clashes with another
# Postgres on 5432. Running Homebrew's Postgres instead? Set 5432, then run
# make db-local once.
DB_PORT=5433

# The rest follow DB_PORT; you rarely need to change them.
# Owner role: runs migrations only.
MIGRATE_DATABASE_URL=postgres://onexn_owner:dev@localhost:${DB_PORT}/onexn?sslmode=disable
# App role: what the API connects as. Row-Level Security applies.
DATABASE_URL=postgres://onexn_app:dev@localhost:${DB_PORT}/onexn?sslmode=disable
# Owner connection to the maintenance DB; the e2e tests create throwaway databases here.
TEST_DATABASE_URL=postgres://onexn_owner:dev@localhost:${DB_PORT}/postgres?sslmode=disable
HTTP_ADDR=:8080
API_URL=http://localhost:8080
